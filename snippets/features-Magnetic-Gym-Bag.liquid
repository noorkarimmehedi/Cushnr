<div class="pf-block">
  <ul class="pf-list">
    <li class="pf-item">
      <span class="pf-index">01</span>
      <span class="pf-icon">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="none">
          <path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z" fill="#2563EB"/>
          <path d="m9 12 2 2 4-4" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
      <span class="pf-text">Hecht direct aan fitnessapparatuur</span>
    </li>
    <li class="pf-item">
      <span class="pf-index">02</span>
      <span class="pf-icon">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="none">
          <path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z" fill="#2563EB"/>
          <path d="m9 12 2 2 4-4" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
      <span class="pf-text">Houdt je fles, telefoon en essentials veilig opgeborgen</span>
    </li>
    <li class="pf-item">
      <span class="pf-index">03</span>
      <span class="pf-icon">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="none">
          <path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z" fill="#2563EB"/>
          <path d="m9 12 2 2 4-4" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
      <span class="pf-text">Houdt je spullen van vuile vloeren af</span>
    </li>
  </ul>
</div>

{% style %}
  .pf-block {
    --pf-blue: #2563EB;
    --pf-ink: #0A0A0A;
    --pf-rule: #D1D5DB;
    --pf-muted: #6B7280;
    --pf-bg: #FAFAFA;

    background: var(--pf-bg);
    border-top: 1px solid var(--pf-ink);
    border-bottom: 1px solid var(--pf-rule);
    margin: 12px 0;
    padding: 0;
    width: 100%;
  }

  .pf-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .pf-item {
    display: grid;
    grid-template-columns: 28px 24px 1fr;
    align-items: center;
    gap: 10px;
    padding: 7px 12px 7px 0;
    border-bottom: 1px solid var(--pf-rule);
    position: relative;
  }

  .pf-item:last-child {
    border-bottom: none;
  }

  .pf-index {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 9px;
    font-weight: 400;
    color: var(--pf-muted);
    letter-spacing: 0.08em;
    line-height: 1;
    text-align: right;
    /* Swiss: the number column anchors the grid, editorial-style */
    padding-right: 4px;
    border-right: 1px solid var(--pf-rule);
    align-self: stretch;
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  .pf-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    flex-shrink: 0;
  }

  .pf-text {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 11px;
    font-weight: 400;
    color: var(--pf-ink);
    line-height: 1.45;
    letter-spacing: 0.02em;
    text-transform: none;
  }
{% endstyle %}
