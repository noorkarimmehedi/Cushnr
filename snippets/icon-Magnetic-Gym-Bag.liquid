<!DOCTYPE html>
<html lang="nl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Trust Badges — Swiss Luxury</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Neue+Haas+Unica:wght@300;400;500&family=Playfair+Display:ital,wght@0,400;1,400&display=swap" rel="stylesheet">

<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background: #f5f5f5;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    padding: 40px 20px;
    font-family: 'Neue Haas Unica', 'Helvetica Neue', Helvetica, sans-serif;
  }

  .component-wrapper {
    width: 100%;
    max-width: 560px;
  }

  /* ─── TRUST BADGES ─────────────────────────────────── */

  .trust-badges-bar {
    background: #ffffff;
    border: 1px solid #c9a96e;
    border-bottom: none;
    display: grid;
    grid-template-columns: 1fr 1px 1fr;
    width: 100%;
  }

  .trust-badge-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 16px;
    padding: 20px 28px;
    position: relative;
    justify-content: center;
  }

  .trust-badge-item::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 28px;
    right: 28px;
    height: 1px;
    background: transparent;
  }

  .trust-badge-icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
  }

  .trust-badge-icon svg {
    width: 28px;
    height: 28px;
    stroke: #b8882a;
  }

  .trust-badge-text {
    display: flex;
    flex-direction: column;
    gap: 1px;
    text-align: center;
    align-items: center;
  }

  .trust-badge-label {
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #b8882a;
    line-height: 1;
  }

  .trust-badge-line1 {
    font-size: 13px;
    font-weight: 400;
    color: #111111;
    letter-spacing: 0.01em;
    line-height: 1.3;
    margin-top: 4px;
  }

  .trust-badge-line2 {
    font-size: 13px;
    font-weight: 500;
    color: #111111;
    letter-spacing: 0.01em;
    font-style: italic;
    font-family: 'Playfair Display', Georgia, serif;
  }

  .trust-badge-divider {
    background: #c9a96e;
    width: 1px;
    align-self: stretch;
  }

  /* ─── SHIPPING COUNTDOWN ────────────────────────────── */

  .shipping-countdown-bar {
    background: #ffffff;
    border: 1px solid #c9a96e;
    padding: 0;
    width: 100%;
    overflow: hidden;
  }

  .shipping-countdown-inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: stretch;
  }

  .shipping-icon-block {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 14px 20px;
    border-right: 1px solid #e8d5b0;
  }

  .shipping-icon-block svg {
    width: 22px;
    height: 22px;
    fill: #b8882a;
  }

  .shipping-text-block {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    padding: 14px 20px;
    gap: 6px;
    flex-wrap: wrap;
  }

  .shipping-label {
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #888888;
    white-space: nowrap;
  }

  .shipping-countdown-time {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.12em;
    color: #111111;
    font-family: 'Neue Haas Unica', 'Helvetica Neue', Helvetica, sans-serif;
    font-style: normal;
    white-space: nowrap;
    background: #fdf8ef;
    padding: 2px 10px;
    border: 1px solid #c9a96e;
  }

  .shipping-rule-block {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 14px 20px;
    border-left: 1px solid #e8d5b0;
  }

  .shipping-rule-line {
    width: 24px;
    height: 1px;
    background: #e8d5b0;
    position: relative;
  }

  .shipping-rule-line::before,
  .shipping-rule-line::after {
    content: '';
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 3px;
    height: 3px;
    background: #c9a96e;
    border-radius: 50%;
  }

  .shipping-rule-line::before { left: -1px; }
  .shipping-rule-line::after { right: -1px; }

  /* ─── MOBILE ────────────────────────────────────────── */

  @media (max-width: 480px) {
    .trust-badge-item {
      padding: 16px 18px;
      gap: 12px;
    }

    .trust-badge-icon svg {
      width: 22px;
      height: 22px;
    }

    .trust-badge-line1,
    .trust-badge-line2 {
      font-size: 12px;
    }

    .shipping-label {
      font-size: 8px;
    }

    .shipping-icon-block,
    .shipping-rule-block {
      padding: 12px 14px;
    }

    .shipping-text-block {
      padding: 12px 14px;
    }
  }
</style>
</head>
<body>
<div class="component-wrapper">

  <!-- Trust Badges -->
  <div class="trust-badges-bar">
    <div class="trust-badge-item">
      <div class="trust-badge-icon">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19.5 17.5C19.5 18.8807 18.3807 20 17 20C15.6193 20 14.5 18.8807 14.5 17.5C14.5 16.1193 15.6193 15 17 15C18.3807 15 19.5 16.1193 19.5 17.5Z"/>
          <path d="M9.5 17.5C9.5 18.8807 8.38071 20 7 20C5.61929 20 4.5 18.8807 4.5 17.5C4.5 16.1193 5.61929 15 7 15C8.38071 15 9.5 16.1193 9.5 17.5Z"/>
          <path d="M14.5 17.5H9.5M19.5 17.5H20.2632C20.4831 17.5 20.5931 17.5 20.6855 17.4885C21.3669 17.4036 21.9036 16.8669 21.9885 16.1855C22 16.0931 22 15.9831 22 15.7632V13C22 9.41015 19.0899 6.5 15.5 6.5M15 15.5V7C15 5.58579 15 4.87868 14.5607 4.43934C14.1213 4 13.4142 4 12 4H5C3.58579 4 2.87868 4 2.43934 4.43934C2 4.87868 2 5.58579 2 7V15C2 15.9346 2 16.4019 2.20096 16.75C2.33261 16.978 2.52197 17.1674 2.75 17.299C3.09808 17.5 3.56538 17.5 4.5 17.5"/>
          <path d="M6.5 7V10.9998M10.5 7V10.9998"/>
        </svg>
      </div>
      <div class="trust-badge-text">
        <span class="trust-badge-label">Levering</span>
        <span class="trust-badge-line1">Verzending binnen 24u</span>
        <span class="trust-badge-line2">met tracking</span>
      </div>
    </div>

    <div class="trust-badge-divider"></div>

    <div class="trust-badge-item">
      <div class="trust-badge-icon">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22Z"/>
          <path d="M9 12L11 14L15 10"/>
        </svg>
      </div>
      <div class="trust-badge-text">
        <span class="trust-badge-label">Garantie</span>
        <span class="trust-badge-line1">60 dagen retour</span>
        <span class="trust-badge-line2">garantie</span>
      </div>
    </div>
  </div>

  <!-- Shipping Countdown -->
  <div class="shipping-countdown-bar">
    <div class="shipping-countdown-inner">

      <div class="shipping-icon-block">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
          <path d="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zM6 18.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm13.5-9l1.96 2.5H17V9.5h2.5zm-1.5 9c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/>
        </svg>
      </div>

      <div class="shipping-text-block">
        <span class="shipping-label">Bestel binnen</span>
        <span class="shipping-countdown-time" id="shipping-timer-main">--</span>
        <span class="shipping-label">om vandaag te verzenden</span>
      </div>

      <div class="shipping-rule-block">
        <div class="shipping-rule-line"></div>
      </div>

    </div>
  </div>

</div>

<script>
(function() {
  var CUTOFF_HOUR = 17;
  var CUTOFF_MINUTE = 0;
  var TIMEZONE = 'Europe/Amsterdam';

  function getSecondsUntilCutoff() {
    var now = new Date();
    var nlNow = new Date(now.toLocaleString('en-US', { timeZone: TIMEZONE }));
    var nlCutoff = new Date(nlNow);
    nlCutoff.setHours(CUTOFF_HOUR, CUTOFF_MINUTE, 0, 0);
    if (nlNow >= nlCutoff) nlCutoff.setDate(nlCutoff.getDate() + 1);
    return Math.floor((nlCutoff - nlNow) / 1000);
  }

  function formatTime(totalSeconds) {
    if (totalSeconds <= 0) return '0u 00m 00s';
    var h = Math.floor(totalSeconds / 3600);
    var m = Math.floor((totalSeconds % 3600) / 60);
    var s = totalSeconds % 60;
    var parts = [];
    if (h > 0) parts.push(h + 'u');
    parts.push((m < 10 ? '0' : '') + m + 'm');
    parts.push((s < 10 ? '0' : '') + s + 's');
    return parts.join(' ');
  }

  function tick() {
    var el = document.getElementById('shipping-timer-main');
    if (!el) return;
    el.textContent = formatTime(getSecondsUntilCutoff());
  }

  tick();
  setInterval(tick, 1000);
})();
</script>
</body>
</html>