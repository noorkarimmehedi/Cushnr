<div class="shipping-countdown-bar">
  <div class="shipping-countdown-inner">
    <span class="shipping-countdown-truck">🚚</span>
    <span class="shipping-countdown-text">Bestel binnen <span class="shipping-countdown-time" id="shipping-timer-{{ section.id }}">--</span> om vandaag te verzenden</span>
  </div>
</div>

<style>
  .trust-badges-bar {
    background-color: #f2f2f2;
    border-radius: 0;
    border: 2px solid #111111;
    border-bottom: none;
    padding: 10px 28px;
    margin: 16px 0 0 0;
    width: 100%;
    box-sizing: border-box;
  }

  .trust-badges-inner {
    display: flex;
    align-items: center;
    justify-content: space-around;
  }

  .trust-badge-item {
    display: flex;
    align-items: center;
    gap: 14px;
    flex: 1;
    justify-content: center;
  }

  .trust-badge-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .trust-badge-icon svg {
    width: 38px;
    height: 38px;
  }

  .trust-badge-text {
    display: flex;
    flex-direction: column;
    line-height: 1.35;
  }

  .trust-badge-line1 {
    font-size: 12px;
    color: #111111;
    font-weight: 400;
  }

  .trust-badge-line2 {
    font-size: 12px;
    color: #111111;
    font-weight: 700;
  }

  .trust-badge-divider {
    width: 1px;
    height: 42px;
    background-color: #cccccc;
    flex-shrink: 0;
    margin: 0 8px;
  }

  /* Verzending Afteltimer */
  .shipping-countdown-bar {
    background-color: #f2f2f2;
    border: 2px solid #111111;
    padding: 9px 20px;
    margin: 0 0 16px 0;
    width: 100%;
    box-sizing: border-box;
    text-align: center;
  }

  .shipping-countdown-inner {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .shipping-countdown-truck {
    font-size: 18px;
    line-height: 1;
  }

  .shipping-countdown-text {
    font-size: 14px;
    color: #111111;
    font-weight: 400;
    text-align: center;
  }

  .shipping-countdown-time {
    color: #2563eb;
    font-weight: 700;
  }

  @media (max-width: 480px) {
    .trust-badges-bar {
      padding: 8px 16px;
    }

    .shipping-countdown-bar {
      padding: 8px 16px;
    }

    .trust-badge-line1,
    .trust-badge-line2 {
      font-size: 12px;
    }

    .trust-badge-item {
      gap: 10px;
    }

    .trust-badge-icon svg {
      width: 30px;
      height: 30px;
    }

    .shipping-countdown-text {
      font-size: 12px;
    }
  }
</style>

<script>
(function() {
  var timerId = 'shipping-timer-{{ section.id }}';

  // Cutoff time: 17:00 (5 PM) Netherlands time
  var CUTOFF_HOUR = 17;
  var CUTOFF_MINUTE = 0;
  var TIMEZONE = 'Europe/Amsterdam';

  function getSecondsUntilCutoff() {
    var now = new Date();

    // Get current time in Netherlands timezone
    var nlNow = new Date(now.toLocaleString('en-US', { timeZone: TIMEZONE }));

    // Build cutoff in Netherlands timezone for today
    var nlCutoff = new Date(nlNow);
    nlCutoff.setHours(CUTOFF_HOUR, CUTOFF_MINUTE, 0, 0);

    // If cutoff already passed, set to tomorrow
    if (nlNow >= nlCutoff) {
      nlCutoff.setDate(nlCutoff.getDate() + 1);
    }

    return Math.floor((nlCutoff - nlNow) / 1000);
  }

  function formatTime(totalSeconds) {
    if (totalSeconds <= 0) return '0u 0min 0s';
    var h = Math.floor(totalSeconds / 3600);
    var m = Math.floor((totalSeconds % 3600) / 60);
    var s = totalSeconds % 60;
    var parts = [];
    if (h > 0) parts.push(h + 'u');
    parts.push(m + 'min');
    parts.push(s + 's');
    return parts.join(' ');
  }

  function tick() {
    var el = document.getElementById(timerId);
    if (!el) return;
    var secs = getSecondsUntilCutoff();
    el.textContent = formatTime(secs);
  }

  tick();
  setInterval(tick, 1000);
})();
</script>
