<style>
  .trust-badges-bar {
    background-color: #ffffff;
    border: 1px solid #111111;
    border-bottom: none;
    padding: 0;
    margin: 16px 0 0 0;
    width: 100%;
    box-sizing: border-box;
  }

  .trust-badges-inner {
    display: flex;
    align-items: stretch;
    justify-content: space-around;
  }

  .trust-badge-item {
    display: flex;
    align-items: center;
    gap: 14px;
    flex: 1;
    justify-content: center;
    padding: 18px 20px;
  }

  .trust-badge-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .trust-badge-icon svg {
    width: 34px;
    height: 34px;
  }

  .trust-badge-text {
    display: flex;
    flex-direction: column;
    line-height: 1.4;
    text-align: center;
  }

  .trust-badge-line1 {
    font-size: 12px;
    color: #111111;
    font-weight: 400;
    letter-spacing: 0.01em;
  }

  .trust-badge-line2 {
    font-size: 10px;
    color: #b8882a;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .trust-badge-divider {
    width: 1px;
    background-color: #111111;
    flex-shrink: 0;
    align-self: stretch;
  }

  /* Verzending Afteltimer */
  .shipping-countdown-bar {
    background-color: #ffffff;
    border: 1px solid #111111;
    padding: 11px 20px;
    margin: 0 0 16px 0;
    width: 100%;
    box-sizing: border-box;
    text-align: center;
  }

  .shipping-countdown-inner {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }

  .shipping-countdown-text {
    font-size: 13px;
    color: #111111;
    font-weight: 400;
    letter-spacing: 0.01em;
  }

  .shipping-countdown-time {
    color: #111111;
    font-weight: 600;
    letter-spacing: 0.06em;
    font-style: normal;
    font-family: inherit;
  }

  @media (max-width: 480px) {
    .trust-badge-item {
      padding: 14px 12px;
      gap: 10px;
    }

    .trust-badge-icon svg {
      width: 26px;
      height: 26px;
    }

    .trust-badge-line1 {
      font-size: 11px;
    }

    .shipping-countdown-bar {
      padding: 9px 14px;
    }

    .shipping-countdown-text {
      font-size: 12px;
    }
  }
</style>

<script>
(function() {
  var timerId = 'shipping-timer-{{ section.id }}';

  var CUTOFF_HOUR = 17;
  var CUTOFF_MINUTE = 0;
  var TIMEZONE = 'Europe/Amsterdam';

  function getSecondsUntilCutoff() {
    var now = new Date();
    var nlNow = new Date(now.toLocaleString('en-US', { timeZone: TIMEZONE }));
    var nlCutoff = new Date(nlNow);
    nlCutoff.setHours(CUTOFF_HOUR, CUTOFF_MINUTE, 0, 0);
    if (nlNow >= nlCutoff) {
      nlCutoff.setDate(nlCutoff.getDate() + 1);
    }
    return Math.floor((nlCutoff - nlNow) / 1000);
  }

  function formatTime(totalSeconds) {
    if (totalSeconds <= 0) return '0u 0min 0s';
    var h = Math.floor(totalSeconds / 3600);
    var m = Math.floor((totalSeconds % 3600) / 60);
    var s = totalSeconds % 60;
    var parts = [];
    if (h > 0) parts.push(h + 'u');
    parts.push(m + 'min');
    parts.push(s + 's');
    return parts.join(' ');
  }

  function tick() {
    var el = document.getElementById(timerId);
    if (!el) return;
    var secs = getSecondsUntilCutoff();
    el.textContent = formatTime(secs);
  }

  tick();
  setInterval(tick, 1000);
})();
</script>
