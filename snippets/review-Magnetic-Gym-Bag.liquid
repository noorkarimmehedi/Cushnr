<style>
  .rmgb-wrap {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 0;
    margin: 0;
    font-family: inherit;
    line-height: 1;
  }

  .rmgb-stars {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .rmgb-star {
    width: 20px;
    height: 20px;
    background-color: #00b67a;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 2px;
    flex-shrink: 0;
  }

  .rmgb-star.half {
    background: linear-gradient(90deg, #00b67a 50%, #dcdce6 50%);
  }

  .rmgb-star svg {
    width: 13px;
    height: 13px;
    color: #ffffff;
    stroke: #ffffff;
    fill: none;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .rmgb-label {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 12px;
    color: #1a1a1a;
    white-space: nowrap;
  }

  .rmgb-label strong {
    font-weight: 700;
  }

  .rmgb-label span {
    font-weight: 400;
    color: #555;
  }
</style>

