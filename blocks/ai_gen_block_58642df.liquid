{% doc %}
  @prompt
    generate a video loop section where the section will adapt the video size and have a headline and description. all should be customizable also the vidoe should be on loop and auto playand no button for maximise the video or for sound, on desktop the video should be on left and the text headline and description should be on right. there should be gap on left and right side on mobile verison, video should be selected from shopify , a text is visible below the video: ayuvynhlrbwzfykvnmaigenblock9e78bc6gbbkyb. also should have option for  text allingment on both desktop and mobile , still a unknown text is visible i don't want it: aswdiuglsy28ycu9kzaigenblock207b115rjctkv
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-video-loop-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_mobile }}px 20px;
  }

  .ai-video-loop-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.gap_mobile }}px;
    align-items: center;
  }

  .ai-video-loop-video-wrapper-{{ ai_gen_id }} {
    width: 100%;
    position: relative;
    border-radius: {{ block.settings.video_border_radius }}px;
    overflow: hidden;
  }

  .ai-video-loop-video-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .ai-video-loop-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-video-loop-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 400px;
    max-height: 400px;
  }

  .ai-video-loop-content-{{ ai_gen_id }} {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.text_gap }}px;
    text-align: {{ block.settings.text_alignment_mobile }};
  }

  /* ── Headline & highlight ── */
  .ai-video-loop-headline-{{ ai_gen_id }} {
    font-size: {{ block.settings.headline_size_mobile }}px;
    font-weight: 600;
    color: {{ block.settings.headline_color }};
    margin: 0;
    line-height: 1.3;
    /* Creates a new stacking context so z-index:-1 on ::before stays
       visible above the section background but behind the text */
    isolation: isolate;
  }

  /*
   * .highlight-text wraps the word(s) that get the animated marker.
   * The ::before pseudo-element slides from scaleX(0) → scaleX(1).
   */

  .ai-video-loop-headline-{{ ai_gen_id }} .highlight-text-{{ ai_gen_id }} {
    position: relative;
    display: inline;
    white-space: nowrap;
  }

  /* The highlight bar — sits behind the text characters */
  .ai-video-loop-headline-{{ ai_gen_id }} .highlight-text-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    left: -4px;
    right: -4px;
    bottom: {{ block.settings.highlight_offset }}px;
    height: {{ block.settings.highlight_height }}px;
    background-color: {{ block.settings.highlight_color }};
    border-radius: {{ block.settings.highlight_radius }}px;
    z-index: -1;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform {{ block.settings.highlight_duration }}ms {{ block.settings.highlight_easing }} {{ block.settings.highlight_delay }}ms;
  }

  .ai-video-loop-headline-{{ ai_gen_id }} .highlight-text-{{ ai_gen_id }}.is-visible::before {
    transform: scaleX(1);
  }

  /* ── Description ── */
  .ai-video-loop-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size_mobile }}px;
    color: {{ block.settings.description_color }};
    line-height: 1.6;
    margin: 0;
  }

  /* ── Desktop ── */
  @media screen and (min-width: 750px) {
    .ai-video-loop-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_desktop }}px 40px;
    }

    .ai-video-loop-container-{{ ai_gen_id }} {
      flex-direction: row;
      gap: {{ block.settings.gap_desktop }}px;
      align-items: center;
    }

    .ai-video-loop-video-wrapper-{{ ai_gen_id }} {
      width: {{ block.settings.video_width_desktop }}%;
      flex-shrink: 0;
    }

    .ai-video-loop-content-{{ ai_gen_id }} {
      flex: 1;
      text-align: {{ block.settings.text_alignment_desktop }};
    }

    .ai-video-loop-headline-{{ ai_gen_id }} {
      font-size: {{ block.settings.headline_size_desktop }}px;
    }

    .ai-video-loop-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size_desktop }}px;
    }
  }
{% endstyle %}

<video-loop-{{ ai_gen_id }} class="ai-video-loop-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-video-loop-container-{{ ai_gen_id }}">

    <!-- Video -->
    <div class="ai-video-loop-video-wrapper-{{ ai_gen_id }}">
      {% if block.settings.video != blank %}
        <video
          class="ai-video-loop-video-{{ ai_gen_id }}"
          autoplay
          loop
          muted
          playsinline
          disablepictureinpicture
          controlslist="nodownload nofullscreen noremoteplayback"
        >
          {% for source in block.settings.video.sources %}
            <source src="{{ source.url }}" type="{{ source.mime_type }}">
          {% endfor %}
        </video>
      {% else %}
        <div class="ai-video-loop-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>

    <!-- Text content -->
    <div class="ai-video-loop-content-{{ ai_gen_id }}">
      {% if block.settings.headline != blank %}
        <h2 class="ai-video-loop-headline-{{ ai_gen_id }}">
          {%- assign headline_text = block.settings.headline -%}
          {%- assign highlight_word = block.settings.highlight_word -%}
          {%- if highlight_word != blank and headline_text contains highlight_word -%}
            {%- assign parts = headline_text | split: highlight_word -%}
            {{ parts[0] }}<span class="highlight-text-{{ ai_gen_id }}">{{ highlight_word }}</span>{{ parts[1] }}
          {%- else -%}
            {{ headline_text }}
          {%- endif -%}
        </h2>
      {% endif %}

      {% if block.settings.description != blank %}
        <div class="ai-video-loop-description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
      {% endif %}
    </div>

  </div>
</video-loop-{{ ai_gen_id }}>

<script>
  (function() {
    class VideoLoop{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        // ── Video controls ──
        const video = this.querySelector('.ai-video-loop-video-{{ ai_gen_id }}');
        if (video) {
          video.addEventListener('contextmenu', e => e.preventDefault());
          const videoObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
              entry.isIntersecting ? video.play().catch(() => {}) : video.pause();
            });
          }, { threshold: 0.5 });
          videoObserver.observe(video);
        }

        // ── Highlight animation ──
        const highlight = this.querySelector('.highlight-text-{{ ai_gen_id }}');
        if (highlight) {
          const triggerAnimation = () => {
            highlight.classList.add('is-visible');
          };

          // Use IntersectionObserver so animation fires when scrolled into view
          if ('IntersectionObserver' in window) {
            const highlightObserver = new IntersectionObserver((entries) => {
              entries.forEach(entry => {
                if (entry.isIntersecting) {
                  // Small rAF delay so the browser paints the element first
                  requestAnimationFrame(() => {
                    setTimeout(triggerAnimation, 100);
                  });
                  highlightObserver.unobserve(entry.target);
                }
              });
            }, { threshold: 0.3 });
            highlightObserver.observe(highlight);
          } else {
            triggerAnimation();
          }
        }
      }
    }

    if (!customElements.get('video-loop-{{ ai_gen_id }}')) {
      customElements.define('video-loop-{{ ai_gen_id }}', VideoLoop{{ ai_gen_id }});
    }
  })();
</script>

