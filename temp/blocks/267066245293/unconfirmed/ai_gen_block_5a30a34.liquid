{% doc %}
  @prompt
    generate a video loop section where the section will adapt the video size and have a headline and description. all should be customizable also the vidoe should be on loop and auto playand no button for maximise the video or for sound, on desktop the video should be on left and the text headline and description should be on right. there should be gap on left and right side on mobile verison
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-video-loop-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_mobile }}px 20px;
  }

  .ai-video-loop-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.gap_mobile }}px;
    align-items: center;
  }

  .ai-video-loop-video-wrapper-{{ ai_gen_id }} {
    width: 100%;
    position: relative;
    border-radius: {{ block.settings.video_border_radius }}px;
    overflow: hidden;
  }

  .ai-video-loop-video-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .ai-video-loop-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-video-loop-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 400px;
    max-height: 400px;
  }

  .ai-video-loop-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-video-loop-content-{{ ai_gen_id }} {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.text_gap }}px;
  }

  .ai-video-loop-headline-{{ ai_gen_id }} {
    font-size: {{ block.settings.headline_size_mobile }}px;
    font-weight: 600;
    color: {{ block.settings.headline_color }};
    margin: 0;
    line-height: 1.2;
  }

  .ai-video-loop-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size_mobile }}px;
    color: {{ block.settings.description_color }};
    line-height: 1.6;
    margin: 0;
  }

  @media screen and (min-width: 750px) {
    .ai-video-loop-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_desktop }}px 40px;
    }

    .ai-video-loop-container-{{ ai_gen_id }} {
      flex-direction: row;
      gap: {{ block.settings.gap_desktop }}px;
      align-items: center;
    }

    .ai-video-loop-video-wrapper-{{ ai_gen_id }} {
      width: {{ block.settings.video_width_desktop }}%;
      flex-shrink: 0;
    }

    .ai-video-loop-content-{{ ai_gen_id }} {
      flex: 1;
    }

    .ai-video-loop-headline-{{ ai_gen_id }} {
      font-size: {{ block.settings.headline_size_desktop }}px;
    }

    .ai-video-loop-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size_desktop }}px;
    }
  }
{% endstyle %}

<video-loop-{{ ai_gen_id }} class="ai-video-loop-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-video-loop-container-{{ ai_gen_id }}">
    <div class="ai-video-loop-video-wrapper-{{ ai_gen_id }}">
      {% if block.settings.video != blank %}
        <video
          class="ai-video-loop-video-{{ ai_gen_id }}"
          autoplay
          loop
          muted
          playsinline
          disablepictureinpicture
          controlslist="nodownload nofullscreen noremoteplayback"
        >
          <source src="{{ block.settings.video }}" type="video/mp4">
          Your browser does not support the video tag.
        </video>
      {% else %}
        <div class="ai-video-loop-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-video-loop-empty-state-{{ ai_gen_id }}">
            Next, add a video
          </div>
        </div>
      {% endif %}
    </div>

    <div class="ai-video-loop-content-{{ ai_gen_id }}">
      {% if block.settings.headline != blank %}
        <h2 class="ai-video-loop-headline-{{ ai_gen_id }}">{{ block.settings.headline }}</h2>
      {% endif %}

      {% if block.settings.description != blank %}
        <div class="ai-video-loop-description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
      {% endif %}
    </div>
  </div>
</video-loop-{{ ai_gen_id }}>

<script>
  (function() {
    class VideoLoop{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        const video = this.querySelector('.ai-video-loop-video-{{ ai_gen_id }}');
        
        if (video) {
          video.removeAttribute('controls');
          
          video.addEventListener('contextmenu', function(e) {
            e.preventDefault();
          });

          const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                video.play().catch(() => {});
              } else {
                video.pause();
              }
            });
          }, { threshold: 0.5 });

          observer.observe(video);
        }
      }
    }

    customElements.define('video-loop-{{ ai_gen_id }}', VideoLoop{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Video loop",
  "settings": [
    {
      "type": "header",
      "content": "Video"
    },
    {
      "type": "video_url",
      "id": "video",
      "label": "Video",
      "accept": ["youtube", "vimeo"],
      "info": "Upload a video file or use a video URL"
    },
    {
      "type": "range",
      "id": "video_width_desktop",
      "label": "Video width on desktop",
      "min": 30,
      "max": 70,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "video_border_radius",
      "label": "Video corner radius",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "richtext",
      "id": "headline",
      "label": "Headline",
      "default": "<p>Experience the difference</p>"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Discover how our product transforms your daily routine with innovative features designed for your lifestyle.</p>"
    },
    {
      "type": "range",
      "id": "headline_size_mobile",
      "label": "Headline size (mobile)",
      "min": 18,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "headline_size_desktop",
      "label": "Headline size (desktop)",
      "min": 24,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "description_size_mobile",
      "label": "Description size (mobile)",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "description_size_desktop",
      "label": "Description size (desktop)",
      "min": 14,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "text_gap",
      "label": "Gap between headline and description",
      "min": 8,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "headline_color",
      "label": "Headline",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_mobile",
      "label": "Padding (mobile)",
      "min": 20,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_desktop",
      "label": "Padding (desktop)",
      "min": 40,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Gap between video and text (mobile)",
      "min": 20,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "label": "Gap between video and text (desktop)",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 1000,
      "max": 1800,
      "step": 100,
      "unit": "px",
      "default": 1400
    }
  ],
  "presets": [
    {
      "name": "Video loop"
    }
  ]
}
{% endschema %}
